#!name=中国移动 App 去开屏/运营/商品推广（基于 HAR 增强版）
#!desc=优先 reject 广告/运营位/营销市场/商品推荐接口；避免密文 JSON 改写导致解密失败
#!author=ChatGPT

[MITM]
hostname = client.app.coc.10086.cn, dev.coc.10086.cn, h.app.coc.10086.cn, qwhdcdn.cmcc-cs.cn, res.app.coc.10086.cn, da.mmarket.com

[Rewrite]
# =========================
# A. 你 HAR 里“首页运营/开屏周边”高相关
# =========================
^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DH\/homeSkin\/getHomeSkin$ url reject
^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/homePage\/getTopAreaList$ url reject
^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/newMarketService\/getNewMarket$ url reject
^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DA\/liveSuspension\/getPageCode$ url reject
^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/searchWord\/getSearchWordInfo$ url reject

# 渠道/运营配置：拦了可能导致部分入口消失；但也可能减少“运营位注入”
^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/LN\/channelserver\/getChannelInfo$ url reject

# =========================
# B. 你 HAR 里出现的“营销市场/商品位下发”（很像信息流/推荐位/推广卡片）
# =========================
^https:\/\/dev\.coc\.10086\.cn\/coc3\/coc3-market\/arrange\/getProductBy(Ids|GroupId)\b.*$ url reject

# h.app 侧“触达商品信息”（命中非常多，典型推荐/商品推广）
^https:\/\/h\.app\.coc\.10086\.cn\/ngpsie\/psieappaiddsdkserver\/touchGoodsInfo\/byMarkIds\b.*$ url reject

# =========================
# C. 广告/营销素材 CDN（更“狠”，可能让部分运营图片空白）
# =========================
^https:\/\/(qwhdcdn\.cmcc-cs\.cn|res\.app\.coc\.10086\.cn)\/prd-mgcenter\/.*\.(png|jpg|jpeg|webp)(\?.*)?$ url reject

# =========================
# D. 可能的第三方/市场日志（对去广告帮助不大，但能减少营销 SDK 上报）
# =========================
^https:\/\/da\.mmarket\.com\/udata_v5\/appsdk\/postsyslog$ url reject

# =========================
# E. 【可选】拦“聚合数据/我的页面瀑布流”
# 这些在 HAR 里是大包密文，可能混着广告位，也可能是核心页面数据；
# 如果你打开后出现“首页/我的页面加载异常”，就把这两条注释掉。
# =========================
# ^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/multipleInterfaces\/aggregationData$ url reject
# ^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/mypage\/getMyPageWaterFall$ url reject
# ^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/myPageNew\/getMyPageNew$ url reject
